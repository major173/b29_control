<launch>
  <arg name="launch_realsense" default="true"/>
  <arg name="camera_name" default="camera"/>
  <arg name="serial_no" default=""/>
  <arg name="output_frame" default=""/>
  <arg name="publish_target_to_moveit" default="false"/>
  <arg name="launch_rviz" default="true"/>
  <arg name="rviz_fixed_frame" default="camera_link"/>
  <arg name="rviz_config" default="$(find gp11_perception)/rviz/d435i_cable_tracking.rviz"/>

  <arg name="enable_sync" default="true"/>
  <arg name="align_depth" default="true"/>
  <arg name="enable_color" default="true"/>
  <arg name="enable_gyro" default="false"/>
  <arg name="enable_accel" default="false"/>
  <arg name="unite_imu_method" default="none"/>
  <arg name="clip_distance" default="2.5"/>
  <arg name="initial_reset" default="false"/>
  <arg name="depth_width" default="640"/>
  <arg name="depth_height" default="480"/>
  <arg name="depth_fps" default="30"/>
  <arg name="color_width" default="640"/>
  <arg name="color_height" default="480"/>
  <arg name="color_fps" default="30"/>
  <arg name="enable_confidence" default="false"/>
  <arg name="enable_pointcloud" default="true"/>
  <arg name="point_cloud_topic" default="/$(arg camera_name)/depth/color/points"/>

  <group if="$(arg launch_realsense)" ns="$(arg camera_name)">
    <include file="$(find realsense2_camera)/launch/includes/nodelet.launch.xml">
      <arg name="serial_no" value="$(arg serial_no)"/>
      <arg name="depth_width" value="$(arg depth_width)"/>
      <arg name="depth_height" value="$(arg depth_height)"/>
      <arg name="depth_fps" value="$(arg depth_fps)"/>
      <arg name="color_width" value="$(arg color_width)"/>
      <arg name="color_height" value="$(arg color_height)"/>
      <arg name="color_fps" value="$(arg color_fps)"/>
      <arg name="enable_depth" value="true"/>
      <arg name="enable_color" value="$(arg enable_color)"/>
      <arg name="enable_infra1" value="false"/>
      <arg name="enable_infra2" value="false"/>
      <arg name="enable_fisheye" value="false"/>
      <arg name="enable_gyro" value="$(arg enable_gyro)"/>
      <arg name="enable_accel" value="$(arg enable_accel)"/>
      <arg name="enable_confidence" value="$(arg enable_confidence)"/>
      <arg name="enable_pointcloud" value="$(arg enable_pointcloud)"/>
      <arg name="enable_sync" value="$(arg enable_sync)"/>
      <arg name="align_depth" value="$(arg align_depth)"/>
      <arg name="tf_prefix" value="$(arg camera_name)"/>
      <arg name="clip_distance" value="$(arg clip_distance)"/>
      <arg name="initial_reset" value="$(arg initial_reset)"/>
      <arg name="unite_imu_method" value="$(arg unite_imu_method)"/>
    </include>
  </group>

  <!-- Default production/runtime path: C++ tracker. -->
  <node pkg="gp11_perception" type="gp11_d435i_cable_tracker_node" name="gp11_d435i_cable_tracker" output="screen">
    <rosparam command="load" file="$(find gp11_perception)/config/d435i_cable_tracking.yaml"/>
    <param name="color_topic" value="/$(arg camera_name)/color/image_raw"/>
    <param name="depth_topic" value="/$(arg camera_name)/aligned_depth_to_color/image_raw"/>
    <param name="camera_info_topic" value="/$(arg camera_name)/color/camera_info"/>
    <param name="point_cloud_topic" value="$(arg point_cloud_topic)"/>
    <param name="output_frame" value="$(arg output_frame)"/>
    <param name="publish_target_to_moveit" value="$(arg publish_target_to_moveit)"/>
  </node>

  <node if="$(arg launch_rviz)" pkg="rviz" type="rviz" name="gp11_d435i_cable_rviz" output="screen"
        args="-d $(arg rviz_config) -f $(arg rviz_fixed_frame)"/>
</launch>
