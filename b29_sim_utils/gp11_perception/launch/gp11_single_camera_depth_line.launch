<launch>
  <arg name="depth_topic" default="/camera/depth/image_rect_raw"/>
  <arg name="camera_info_topic" default="/camera/depth/camera_info"/>
  <arg name="background_depth_path" default=""/>
  <arg name="output_frame" default="world"/>
  <arg name="publish_target_to_moveit" default="false"/>
  <arg name="launch_rviz" default="false"/>
  <arg name="rviz_fixed_frame" default="camera_link"/>
  <arg name="rviz_config" default="$(find gp11_perception)/rviz/depth_line_tracking.rviz"/>

  <node pkg="gp11_perception" type="gp11_single_camera_depth_line.py" name="gp11_single_camera_depth_line" output="screen">
    <rosparam command="load" file="$(find gp11_perception)/config/single_camera_depth_line.yaml"/>
    <param name="depth_topic" value="$(arg depth_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="background_depth_path" value="$(arg background_depth_path)"/>
    <param name="output_frame" value="$(arg output_frame)"/>
    <param name="publish_target_to_moveit" value="$(arg publish_target_to_moveit)"/>
  </node>

  <node if="$(arg launch_rviz)" pkg="rviz" type="rviz" name="gp11_perception_rviz" output="screen"
        args="-d $(arg rviz_config) -f $(arg rviz_fixed_frame)"/>
</launch>
