<?xml version="1.0"?>
<launch>
  <arg name="config" default="$(find b29_planner_adapter)/config/planner_adapter.yaml"/>
  <arg name="interface_mode" default="normal"/>
  <arg name="smc_controller_namespace" default="/b29_controller/b29_smc_auto_controller"/>
  <arg name="output" default="screen"/>

  <node pkg="b29_planner_adapter" type="b29_planner_adapter_node"
        name="b29_planner_adapter" output="$(arg output)">
    <rosparam command="load" file="$(arg config)"/>
    <param name="interface_mode" value="$(arg interface_mode)"/>
    <param name="smc_controller_namespace" value="$(arg smc_controller_namespace)"/>
  </node>
</launch>
