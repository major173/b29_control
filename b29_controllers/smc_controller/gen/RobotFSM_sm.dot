digraph RobotFSM {

    node
        [shape=Mrecord width=1.5];

    subgraph cluster_RobotFSM {

        label="RobotFSM";

        //
        // States (Nodes)
        //

        "RobotFSM::Idle"
            [label="{Idle}"];

        "RobotFSM::ManualCtrl"
            [label="{ManualCtrl}"];

        "RobotFSM::AutoInit"
            [label="{AutoInit|Entry/\l&nbsp;&nbsp;&nbsp;ctxt.startInitSequence();\lExit/\l&nbsp;&nbsp;&nbsp;ctxt.clearInitFlags();\l}"];

        "RobotFSM::Traversing"
            [label="{Traversing|Entry/\l&nbsp;&nbsp;&nbsp;ctxt.enableLineTracking();\l&nbsp;&nbsp;&nbsp;ctxt.setTargetSpeedCruise();\lExit/\l&nbsp;&nbsp;&nbsp;ctxt.disableLineTracking();\l|evTick()\l\[ctxt.isObstacleNotDetected()\]/\l&nbsp;&nbsp;&nbsp;ctxt.updateLineTrackingControl();\l&nbsp;&nbsp;&nbsp;ctxt.sendDriveCommand();\l}"];

        "RobotFSM::ObstacleDetected"
            [label="{ObstacleDetected|Entry/\l&nbsp;&nbsp;&nbsp;ctxt.stopAllMotors();\l&nbsp;&nbsp;&nbsp;ctxt.startObstacleClassification();\lExit/\l&nbsp;&nbsp;&nbsp;ctxt.finalizeObstacleClass();\l}"];

        "RobotFSM::Approaching"
            [label="{Approaching|Entry/\l&nbsp;&nbsp;&nbsp;ctxt.setTargetSpeedApproach();\l&nbsp;&nbsp;&nbsp;ctxt.enableObstacleRanging();\lExit/\l&nbsp;&nbsp;&nbsp;ctxt.disableObstacleRanging();\l|evTick()\l\[ctxt.isNotAtCrossingPosition()\]/\l&nbsp;&nbsp;&nbsp;ctxt.updateApproachControl();\l&nbsp;&nbsp;&nbsp;ctxt.sendDriveCommand();\l}"];

        "RobotFSM::PreObstacleStop"
            [label="{PreObstacleStop|Entry/\l&nbsp;&nbsp;&nbsp;ctxt.stopAllMotors();\l&nbsp;&nbsp;&nbsp;ctxt.startPostureAlignment();\l&nbsp;&nbsp;&nbsp;ctxt.loadCrossingPresetFromStrategy();\lExit/\l&nbsp;&nbsp;&nbsp;ctxt.confirmCrossingReady();\l}"];

        "RobotFSM::CrossingLineClamp"
            [label="{CrossingLineClamp|Entry/\l&nbsp;&nbsp;&nbsp;ctxt.startCrossingLineClamp();\l&nbsp;&nbsp;&nbsp;ctxt.enableJointMonitor();\lExit/\l&nbsp;&nbsp;&nbsp;ctxt.disableJointMonitor();\l&nbsp;&nbsp;&nbsp;ctxt.endCrossingSequence();\l|evTick()\l\[ctxt.isCrossingStepPending()\]/\l&nbsp;&nbsp;&nbsp;ctxt.advanceCrossingStep();\l&nbsp;&nbsp;&nbsp;ctxt.sendJointAngleCommand();\l&nbsp;&nbsp;&nbsp;ctxt.sendDriveCommand();\l}"];

        "RobotFSM::CrossingDamper"
            [label="{CrossingDamper|Entry/\l&nbsp;&nbsp;&nbsp;ctxt.startCrossingDamper();\l&nbsp;&nbsp;&nbsp;ctxt.enableJointMonitor();\l&nbsp;&nbsp;&nbsp;ctxt.setTargetSpeedDamper();\lExit/\l&nbsp;&nbsp;&nbsp;ctxt.disableJointMonitor();\l&nbsp;&nbsp;&nbsp;ctxt.endCrossingSequence();\l|evTick()\l\[ctxt.isCrossingStepPending()\]/\l&nbsp;&nbsp;&nbsp;ctxt.advanceCrossingStep();\l&nbsp;&nbsp;&nbsp;ctxt.sendJointAngleCommand();\l&nbsp;&nbsp;&nbsp;ctxt.sendDriveCommand();\l&nbsp;&nbsp;&nbsp;ctxt.checkGripForce();\l}"];

        "RobotFSM::PostObstacleCheck"
            [label="{PostObstacleCheck|Entry/\l&nbsp;&nbsp;&nbsp;ctxt.startPostCrossCheck();\lExit/\l&nbsp;&nbsp;&nbsp;ctxt.clearObstacleState();\l}"];

        "RobotFSM::CommsLoss"
            [label="{CommsLoss|Entry/\l&nbsp;&nbsp;&nbsp;ctxt.stopAllMotors();\l&nbsp;&nbsp;&nbsp;ctxt.startReconnectTimer();\l&nbsp;&nbsp;&nbsp;ctxt.alertCommsLoss();\lExit/\l&nbsp;&nbsp;&nbsp;ctxt.stopReconnectTimer();\l}"];

        "RobotFSM::SafeStop"
            [label="{SafeStop|Entry/\l&nbsp;&nbsp;&nbsp;ctxt.stopAllMotors();\l&nbsp;&nbsp;&nbsp;ctxt.freezeAllJoints();\l&nbsp;&nbsp;&nbsp;ctxt.disableAutoMode();\l&nbsp;&nbsp;&nbsp;ctxt.alertSafeStop();\l&nbsp;&nbsp;&nbsp;ctxt.logSafeStopEntry();\l}"];

        "%start"
            [label="" shape=circle style=filled fillcolor=black width=0.25];

        //
        // Transitions (Edges)
        //

        "RobotFSM::Idle" -> "RobotFSM::AutoInit"
            [label="evAutoStart()\l\[ctxt.canStartAuto()\]/\lctxt.logIdleToAutoInit();\lctxt.initAutoMode();\l"];

        "RobotFSM::Idle" -> "RobotFSM::ManualCtrl"
            [label="evManualEnable()/\lctxt.enableManualPassthrough();\l"];

        "RobotFSM::Idle" -> "RobotFSM::CommsLoss"
            [label="evCommsLost()/\lctxt.stopAllMotors();\lctxt.reportCommsLoss();\l"];

        "RobotFSM::ManualCtrl" -> "RobotFSM::Idle"
            [label="evManualDisable()/\lctxt.disableManualPassthrough();\l"];

        "RobotFSM::ManualCtrl" -> "RobotFSM::SafeStop"
            [label="evEmergencyStop()/\lctxt.stopAllMotors();\lctxt.reportEmergencyStopManual();\l"];

        "RobotFSM::ManualCtrl" -> "RobotFSM::CommsLoss"
            [label="evCommsLost()/\lctxt.stopAllMotors();\lctxt.reportCommsLoss();\l"];

        "RobotFSM::AutoInit" -> "RobotFSM::Traversing"
            [label="evInitDone()\l\[ctxt.isReadyToTraverse()\]/\lctxt.logAutoInitToTraversing();\lctxt.setDriveModeForward();\l"];

        "RobotFSM::AutoInit" -> "RobotFSM::SafeStop"
            [label="evInitFailed()/\lctxt.reportErrorAutoInitFailed();\lctxt.stopAllMotors();\l"];

        "RobotFSM::AutoInit" -> "RobotFSM::CommsLoss"
            [label="evCommsLost()/\lctxt.stopAllMotors();\lctxt.reportCommsLoss();\l"];

        "RobotFSM::AutoInit" -> "RobotFSM::SafeStop"
            [label="evEmergencyStop()/\lctxt.stopAllMotors();\lctxt.reportEmergencyStopInit();\l"];

        "RobotFSM::Traversing" -> "RobotFSM::ObstacleDetected"
            [label="evTick()\l\[ctxt.isObstacleDetected()\]/\lctxt.setTargetSpeedZero();\lctxt.logObstacleFound();\l"];

        "RobotFSM::Traversing" -> "RobotFSM::Idle"
            [label="evAutoRunPause()/\lctxt.stopAllMotors();\lctxt.logTraversingPause();\l"];

        "RobotFSM::Traversing" -> "RobotFSM::CommsLoss"
            [label="evCommsLost()/\lctxt.stopAllMotors();\lctxt.reportCommsLoss();\l"];

        "RobotFSM::Traversing" -> "RobotFSM::SafeStop"
            [label="evEmergencyStop()/\lctxt.stopAllMotors();\lctxt.reportEmergencyStopTraversal();\l"];

        "RobotFSM::ObstacleDetected" -> "RobotFSM::Approaching"
            [label="evTick()\l\[ctxt.isClassifiedAsLineClamp()\]/\lctxt.setStrategyLineClamp();\lctxt.logDetectedLineClamp();\l"];

        "RobotFSM::ObstacleDetected" -> "RobotFSM::Approaching"
            [label="evTick()\l\[ctxt.isClassifiedAsDamper()\]/\lctxt.setStrategyDamper();\lctxt.logDetectedDamper();\l"];

        "RobotFSM::ObstacleDetected" -> "RobotFSM::SafeStop"
            [label="evTick()\l\[ctxt.isClassifiedAsUnknown()\]/\lctxt.reportErrorUnknownObstacle();\lctxt.stopAllMotors();\l"];

        "RobotFSM::ObstacleDetected" -> "RobotFSM::SafeStop"
            [label="evClassifyTimeout()/\lctxt.reportErrorClassifyTimeout();\lctxt.stopAllMotors();\l"];

        "RobotFSM::ObstacleDetected" -> "RobotFSM::CommsLoss"
            [label="evCommsLost()/\lctxt.stopAllMotors();\lctxt.reportCommsLoss();\l"];

        "RobotFSM::ObstacleDetected" -> "RobotFSM::SafeStop"
            [label="evEmergencyStop()/\lctxt.stopAllMotors();\lctxt.reportEmergencyStopClassify();\l"];

        "RobotFSM::Approaching" -> "RobotFSM::PreObstacleStop"
            [label="evTick()\l\[ctxt.isAtCrossingPosition()\]/\lctxt.logApproachingToPreStop();\l"];

        "RobotFSM::Approaching" -> "RobotFSM::SafeStop"
            [label="evApproachTimeout()/\lctxt.reportErrorApproachTimeout();\lctxt.stopAllMotors();\l"];

        "RobotFSM::Approaching" -> "RobotFSM::CommsLoss"
            [label="evCommsLost()/\lctxt.stopAllMotors();\lctxt.reportCommsLoss();\l"];

        "RobotFSM::Approaching" -> "RobotFSM::SafeStop"
            [label="evEmergencyStop()/\lctxt.stopAllMotors();\lctxt.reportEmergencyStopApproach();\l"];

        "RobotFSM::PreObstacleStop" -> "RobotFSM::CrossingLineClamp"
            [label="evTick()\l\[ctxt.isReadyForLineClamp()\]/\lctxt.logPreStopToLineClamp();\l"];

        "RobotFSM::PreObstacleStop" -> "RobotFSM::CrossingDamper"
            [label="evTick()\l\[ctxt.isReadyForDamper()\]/\lctxt.logPreStopToDamper();\l"];

        "RobotFSM::PreObstacleStop" -> "RobotFSM::SafeStop"
            [label="evAlignTimeout()/\lctxt.reportErrorAlignTimeout();\lctxt.stopAllMotors();\l"];

        "RobotFSM::PreObstacleStop" -> "RobotFSM::CommsLoss"
            [label="evCommsLost()/\lctxt.stopAllMotors();\lctxt.reportCommsLoss();\l"];

        "RobotFSM::PreObstacleStop" -> "RobotFSM::SafeStop"
            [label="evEmergencyStop()/\lctxt.stopAllMotors();\lctxt.reportEmergencyStopPreStop();\l"];

        "RobotFSM::CrossingLineClamp" -> "RobotFSM::PostObstacleCheck"
            [label="evTick()\l\[ctxt.isCrossingComplete()\]/\lctxt.logLineClampToPostCheck();\l"];

        "RobotFSM::CrossingLineClamp" -> "RobotFSM::SafeStop"
            [label="evJointFault()/\lctxt.stopAllMotors();\lctxt.freezeAllJoints();\lctxt.reportErrorJointFaultLineClamp();\l"];

        "RobotFSM::CrossingLineClamp" -> "RobotFSM::SafeStop"
            [label="evImuFault()/\lctxt.stopAllMotors();\lctxt.freezeAllJoints();\lctxt.reportErrorImuFaultLineClamp();\l"];

        "RobotFSM::CrossingLineClamp" -> "RobotFSM::SafeStop"
            [label="evCrossingTimeout()/\lctxt.stopAllMotors();\lctxt.freezeAllJoints();\lctxt.reportErrorCrossingTimeoutLineClamp();\l"];

        "RobotFSM::CrossingLineClamp" -> "RobotFSM::CommsLoss"
            [label="evCommsLost()/\lctxt.stopAllMotors();\lctxt.freezeAllJoints();\lctxt.reportCommsLoss();\l"];

        "RobotFSM::CrossingLineClamp" -> "RobotFSM::SafeStop"
            [label="evEmergencyStop()/\lctxt.stopAllMotors();\lctxt.freezeAllJoints();\lctxt.reportEmergencyStopLineClamp();\l"];

        "RobotFSM::CrossingDamper" -> "RobotFSM::PostObstacleCheck"
            [label="evTick()\l\[ctxt.isCrossingComplete()\]/\lctxt.logDamperToPostCheck();\l"];

        "RobotFSM::CrossingDamper" -> "RobotFSM::SafeStop"
            [label="evJointFault()/\lctxt.stopAllMotors();\lctxt.freezeAllJoints();\lctxt.reportErrorJointFaultDamper();\l"];

        "RobotFSM::CrossingDamper" -> "RobotFSM::SafeStop"
            [label="evImuFault()/\lctxt.stopAllMotors();\lctxt.freezeAllJoints();\lctxt.reportErrorImuFaultDamper();\l"];

        "RobotFSM::CrossingDamper" -> "RobotFSM::SafeStop"
            [label="evGripFault()/\lctxt.stopAllMotors();\lctxt.freezeAllJoints();\lctxt.reportErrorGripFault();\l"];

        "RobotFSM::CrossingDamper" -> "RobotFSM::SafeStop"
            [label="evCrossingTimeout()/\lctxt.stopAllMotors();\lctxt.freezeAllJoints();\lctxt.reportErrorCrossingTimeoutDamper();\l"];

        "RobotFSM::CrossingDamper" -> "RobotFSM::CommsLoss"
            [label="evCommsLost()/\lctxt.stopAllMotors();\lctxt.freezeAllJoints();\lctxt.reportCommsLoss();\l"];

        "RobotFSM::CrossingDamper" -> "RobotFSM::SafeStop"
            [label="evEmergencyStop()/\lctxt.stopAllMotors();\lctxt.freezeAllJoints();\lctxt.reportEmergencyStopDamper();\l"];

        "RobotFSM::PostObstacleCheck" -> "RobotFSM::Traversing"
            [label="evTick()\l\[ctxt.isPostCheckPassed()\]/\lctxt.logPostCheckToTraversing();\lctxt.setDriveModeForward();\l"];

        "RobotFSM::PostObstacleCheck" -> "RobotFSM::SafeStop"
            [label="evTick()\l\[ctxt.isPostCheckFailed()\]/\lctxt.reportErrorPostCheckFailed();\lctxt.stopAllMotors();\l"];

        "RobotFSM::PostObstacleCheck" -> "RobotFSM::SafeStop"
            [label="evPostCheckTimeout()/\lctxt.reportErrorPostCheckTimeout();\lctxt.stopAllMotors();\l"];

        "RobotFSM::PostObstacleCheck" -> "RobotFSM::CommsLoss"
            [label="evCommsLost()/\lctxt.stopAllMotors();\lctxt.reportCommsLoss();\l"];

        "RobotFSM::PostObstacleCheck" -> "RobotFSM::SafeStop"
            [label="evEmergencyStop()/\lctxt.stopAllMotors();\lctxt.reportEmergencyStopPostCheck();\l"];

        "RobotFSM::CommsLoss" -> "RobotFSM::Idle"
            [label="evCommsRestored()/\lctxt.logCommsRestored();\lctxt.alertCommsRestored();\l"];

        "RobotFSM::CommsLoss" -> "RobotFSM::SafeStop"
            [label="evReconnectTimeout()/\lctxt.reportErrorReconnectTimeout();\l"];

        "RobotFSM::SafeStop" -> "RobotFSM::Idle"
            [label="evManualReset()/\lctxt.resetFaultFlags();\lctxt.logSafeStopToIdle();\l"];

        "RobotFSM::SafeStop" -> "RobotFSM::ManualCtrl"
            [label="evManualEnable()/\lctxt.resetFaultFlags();\lctxt.enableManualPassthrough();\l"];

        "%start" -> "RobotFSM::Idle"
    }

}
