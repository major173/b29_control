<?xml version="1.0"?>
<!--
  reach_gazebo_stage1.launch — Stage 1~2: Gazebo + position_controllers + RViz

  数据流：
    Gazebo physics → joint_state_controller → /joint_states
    外部 rostopic pub / gazebo_rl_bridge → position_controllers → Gazebo physics
    robot_state_publisher 发布 /tf，RViz 可渲染 URDF mesh

-->
<launch>
    <arg name="use_sim_time" default="true"/>
    <arg name="anchor_side"  default="left"/>   <!-- left/right/base: 固定左端/右端/base_link -->
    <arg name="anchor_roll"  default="0.0"/>   <!-- 固定端相对世界系的 roll，rad -->
    <arg name="anchor_pitch" default="0.0"/>   <!-- 固定端相对世界系的 pitch，rad -->
    <arg name="anchor_yaw"   default="0.0"/>   <!-- 固定端相对世界系的 yaw，rad -->
    <arg name="rviz"         default="false"/>

    <param name="use_sim_time" value="$(arg use_sim_time)"/>

    <param name="robot_description"
           command="xacro $(find b29_control)/urdf/b29/b29.urdf.xacro
                    use_simulation:=true anchor_side:=$(arg anchor_side)"/>

    <rosparam file="$(find b29_control)/config/gazebo_ros_control.yaml" command="load"/>

    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="paused" value="false"/>
        <arg name="use_sim_time" value="true"/>
        <arg name="gui" value="true"/>
        <arg name="headless" value="false"/>
        <arg name="debug" value="false"/>
    </include>

    <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model"
          args="-x 0.0 -y 0.0 -z 1.0
              -R $(arg anchor_roll) -P $(arg anchor_pitch) -Y $(arg anchor_yaw)
              -param robot_description -urdf -model b29"/>

    <rosparam file="$(find b29_control)/config/controller.yaml" command="load"/>
    <rosparam file="$(find b29_control)/config/reach_rl_controllers.yaml" command="load"/>

    <node name="controller_spawner"
          pkg="controller_manager"
          type="spawner"
          output="screen"
          args="b29_controller/joint_state_controller
                b29_controller/robot_state_controller
                b29_controller/imu_sensor_controller
                b29_controller/left_first_leg_joint_position_controller
                b29_controller/left_second_leg_joint_position_controller
                b29_controller/right_first_leg_joint_position_controller
                b29_controller/right_second_leg_joint_position_controller"/>

    <!-- robot_state_publisher: 将 /joint_states 转换为 /tf，RViz 渲染 mesh 必须 -->
    <node name="robot_state_publisher" pkg="robot_state_publisher"
          type="robot_state_publisher" output="screen">
        <param name="publish_frequency" value="50.0"/>
    </node>

    <!-- world → base_link 动态 TF：以固定端为世界基座
         anchor_side=base 时 base_link 已固定到 world，节点直接 spin 无需发布 -->
    <node name="anchor_world_tf_publisher" pkg="b29_control"
          type="anchor_world_tf_publisher.py" output="screen">
        <param name="anchor_link"  value="$(eval 'base_link' if arg('anchor_side') == 'base' else arg('anchor_side') + '_second_leg')"/>
        <param name="anchor_side"  value="$(arg anchor_side)"/>
        <param name="anchor_roll"  value="$(arg anchor_roll)"/>
        <param name="anchor_pitch" value="$(arg anchor_pitch)"/>
        <param name="anchor_yaw"   value="$(arg anchor_yaw)"/>
        <param name="rate"         value="50.0"/>
    </node>

    <!-- RViz -->
    <node if="$(arg rviz)" name="rviz" pkg="rviz" type="rviz"
          args="-d $(find b29_control)/rviz/config.rviz" output="screen"/>
</launch>
