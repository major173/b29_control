<?xml version="1.0"?>
<package format="2">
  <name>rqt_b29_smc_console</name>
  <version>0.0.0</version>
  <description>Standalone rqt console for B29 SMC workflows.</description>

  <maintainer email="yuchen@example.com">yuchen</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>rqt_gui</build_depend>
  <build_depend>rqt_gui_py</build_depend>
  <build_depend>python_qt_binding</build_depend>
  <build_depend>rospkg</build_depend>
  <build_depend>std_srvs</build_depend>
  <build_depend>b29_smc_auto_controller</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>rqt_gui</exec_depend>
  <exec_depend>rqt_gui_py</exec_depend>
  <exec_depend>python_qt_binding</exec_depend>
  <exec_depend>rospkg</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>b29_smc_auto_controller</exec_depend>

  <test_depend>python3-nose</test_depend>
  <test_depend>rospkg</test_depend>
  <test_depend>b29_smc_auto_controller</test_depend>

  <export>
    <rqt_gui plugin="${prefix}/plugin.xml"/>
  </export>
</package>
