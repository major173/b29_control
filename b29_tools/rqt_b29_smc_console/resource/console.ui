  background: #eef4fb;
  color: #1d4061;
}
QLineEdit, QComboBox, QDoubleSpinBox, QListWidget {
  min-height: 30px;
  border: 1px solid #c6d4e1;
  border-radius: 8px;
  background: #ffffff;
  padding: 4px 8px;
}
QGroupBox {
  font-weight: 700;
  border: 1px solid #dce6ef;
  border-radius: 10px;
  margin-top: 12px;
  padding-top: 12px;
}
QGroupBox::title {
  left: 12px;
  padding: 0 4px;
}
